# Entity: batch_geocoding

main: kit: entity: batch_geocoding: {

  alias: field: {}

  name: "batch_geocoding"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/reverse/csv"
          segments: [
            {
              lit: "reverse"
            }
            {
              lit: "csv"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          method: "POST"
          orig: "/search/csv"
          segments: [
            {
              lit: "search"
            }
            {
              lit: "csv"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
